# -----------------------------------------------------------------------------
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync
*.rubbercache
rubber.cache
latex.out/
build/
out/
_build/
dist/
*.fdb
*.arara

