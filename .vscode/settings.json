      "args": [
        "-pvc",
        "-f",
        "-view=none",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;C:\\Users\\Admin\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64;C:\\WINDOWS\\system32;C:\\WINDOWS"
      }
