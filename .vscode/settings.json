      "tools": ["latexmk"]
    },
    {
      "name": "latexmk watch",
      "tools": ["latexmk-pvc"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "C:\\Projetos\\tcc\\scripts\\latexmk.cmd",
      "args": [
        "-f",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
