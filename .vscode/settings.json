{
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.formatting.tex-fmt.path": "C:\\Users\\Admin\\AppData\\Local\\Programs\\tex-fmt\\tex-fmt.exe",
  "latex-workshop.formatting.tex-fmt.args": ["--wraplen", "110"],
  
